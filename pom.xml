<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.codecrafters</groupId>
    <artifactId>redis-java-clone</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <!-- Compile Java sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                    <excludes>
                        <exclude>com/codecrafters/redis/raft/RaftGroup.java</exclude>
                        <exclude>com/codecrafters/redis/raft/RaftGroupManager.java</exclude>
                        <exclude>com/codecrafters/redis/raft/RaftNode.java</exclude>
                        <exclude>com/codecrafters/redis/raft/RaftStorage.java</exclude>
                        <exclude>com/codecrafters/redis/raft/Snapshot.java</exclude>
                        <exclude>com/codecrafters/redis/raft/RaftMessage.java</exclude>
                        <exclude>com/codecrafters/redis/storage/RocksDBEngine.java</exclude>
                        <exclude>com/codecrafters/redis/storage/StorageManager.java</exclude>
                        <exclude>com/codecrafters/redis/sharding/Shard.java</exclude>
                        <exclude>com/codecrafters/redis/sharding/ShardManager.java</exclude>
                        <exclude>com/codecrafters/redis/sharding/ConsistentHash.java</exclude>
                        <exclude>com/codecrafters/redis/sharding/DataMigrator.java</exclude>
                        <exclude>com/codecrafters/redis/rpc/RpcClient.java</exclude>
                        <exclude>com/codecrafters/redis/rpc/RpcServer.java</exclude>
                        <exclude>com/codecrafters/redis/cluster/NodeConfig.java</exclude>
                        <exclude>com/codecrafters/redis/cluster/ClusterManager.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Package executable JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Disable default Surefire runner (tests use native main() runners with assertions) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <!-- Cross-platform test suite executor for 'mvn test' and 'mvn clean test' -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>run-all-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.codecrafters.redis.AllTestsRunner</mainClass>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
