<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.codecrafters</groupId>
    <artifactId>redis-java-clone</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.rocksdb</groupId>
            <artifactId>rocksdbjni</artifactId>
            <version>11.8.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compile Java sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                    <excludes>
                        <!--
                            These files are a separate, incomplete com.distributedkv implementation
                            stored under the com/codecrafters source tree. The executable and tests
                            use the com.codecrafters.redis implementation instead. Keep the legacy
                            sources available without compiling their missing Netty/protobuf APIs.
                        -->
                        <exclude>com/codecrafters/redis/Networks/protocol/**/*.java</exclude>
                        <exclude>com/codecrafters/redis/Networks/handler/**/*.java</exclude>
                        <exclude>com/codecrafters/redis/Networks/server/**/*.java</exclude>
                        <exclude>com/codecrafters/redis/Networks/client/NettyClient.java</exclude>
                        <exclude>com/codecrafters/redis/Networks/client/RpcClient.java</exclude>
                        <exclude>com/codecrafters/redis/Server/NodeManager.java</exclude>
                        <exclude>com/codecrafters/redis/Server/KVServer.java</exclude>
                        <exclude>com/codecrafters/redis/Server/ClusterManager.java</exclude>
                        <exclude>com/codecrafters/redis/common/util/**/*.java</exclude>
                        <exclude>com/codecrafters/redis/raft/AsyncApplier.java</exclude>
                        <exclude>com/codecrafters/redis/raft/FollowerRead.java</exclude>
                        <exclude>com/codecrafters/redis/raft/KVStateMachine.java</exclude>
                        <exclude>com/codecrafters/redis/raft/Log.java</exclude>
                        <exclude>com/codecrafters/redis/raft/LogEntry.java</exclude>
                        <exclude>com/codecrafters/redis/raft/RaftPeer.java</exclude>
                        <exclude>com/codecrafters/redis/raft/ReadIndex.java</exclude>
                        <exclude>com/codecrafters/redis/raft/StateMachine.java</exclude>
                        <exclude>com/codecrafters/redis/raft/election/**/*.java</exclude>
                        <exclude>com/codecrafters/redis/rpc/RpcClient.java</exclude>
                        <exclude>com/codecrafters/redis/rpc/RpcServer.java</exclude>
                        <exclude>com/codecrafters/redis/storage/StorageManager.java</exclude>
                        <exclude>com/codecrafters/redis/storage/RocksDBEngine.java</exclude>
                        <exclude>com/codecrafters/redis/sharding/Shard.java</exclude>
                        <exclude>com/codecrafters/redis/sharding/ShardManager.java</exclude>
                        <exclude>com/codecrafters/redis/sharding/DataMigrator.java</exclude>
                        <exclude>com/codecrafters/redis/cluster/NodeConfig.java</exclude>
                        <exclude>com/codecrafters/redis/cluster/ClusterManager.java</exclude>
                        <exclude>com/codecrafters/redis/raft/RaftGroupManager.java</exclude>
                        <exclude>com/codecrafters/redis/raft/RaftNode.java</exclude>
                        <exclude>com/codecrafters/redis/raft/RaftStorage.java</exclude>
                        <exclude>com/codecrafters/redis/raft/Snapshot.java</exclude>
                        <exclude>com/codecrafters/redis/raft/RaftMessage.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Package executable JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Bundle RocksDB JNI and its native resources in the executable application JAR. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Disable default Surefire runner (tests use native main() runners with assertions) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <!-- Cross-platform test suite executor for 'mvn test' and 'mvn clean test' -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>run-all-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.codecrafters.redis.AllTestsRunner</mainClass>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
